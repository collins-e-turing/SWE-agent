#!/usr/bin/env python3
"""
Apply Patch Tool for SWE-Agent
==============================
Delegates patch application to Makefile targets using the clean architecture pattern.
"""
import os
import sys
import subprocess
from pathlib import Path


def validate_environment():
    """Validate required environment variables."""
    required_vars = ['PROJ_NAME', 'CVE_ID', 'PIPELINE_ROOT']
    missing_vars = [var for var in required_vars if not os.environ.get(var)]
    
    if missing_vars:
        print(f"Error: Missing required environment variables: {', '.join(missing_vars)}")
        return False
    return True


def apply_patch():
    """Apply vulnerability patch using Makefile delegation."""
    if not validate_environment():
        print("❌ Environment validation failed. Not applying patch.")
        return 0

    proj_name = os.environ['PROJ_NAME']
    cve_id = os.environ['CVE_ID']
    pipeline_root = os.environ['PIPELINE_ROOT']

    print(f"🩹 Applying patch for {proj_name} {cve_id}")
    print(f"📁 Pipeline root: {pipeline_root}")

    # Delegate to Makefile target
    try:
        cmd = ['make', f'patch-{proj_name}', f'CVE_ID={cve_id}']
        result = subprocess.run(cmd, cwd=pipeline_root, check=True)
        print("✅ Patch applied successfully")
    except subprocess.CalledProcessError as e:
        print(f"❌ Failed to apply patch: {e}")
        return 1
    except Exception as e:
        print(f"❌ Error: {e}")
        return 1
    return 0


def main():
    apply_patch()

if __name__ == "__main__":
    main()
