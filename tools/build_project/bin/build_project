#!/usr/bin/env bash
set -euo pipefail

###############################################################################
# Build Project Tool - Delegates to pipeline Makefile
# Follows architectural principle: Tools orchestrate, Makefile implements
###############################################################################

if [[ $# -ne 1 ]]; then
  echo "Usage: build_project <source_code_path>"
  exit 1
fi

SOURCE_PATH="$1"

# Validate required environment variables
if [[ -z "${PROJ_NAME:-}" ]]; then
  echo "Error: PROJ_NAME environment variable not set"
  exit 1
fi

if [[ -z "${CVE_ID:-}" ]]; then
  echo "Error: CVE_ID environment variable not set"
  exit 1
fi

if [[ -z "${PIPELINE_ROOT:-}" ]]; then
  echo "Error: PIPELINE_ROOT environment variable not set"
  exit 1
fi

if [[ -z "${BINARY_PATH:-}" ]]; then
  echo "Error: BINARY_PATH environment variable not set"
  exit 1
fi

if [[ ! -d "$SOURCE_PATH" ]]; then
  echo "Error: Source path '$SOURCE_PATH' does not exist"
  exit 1
fi

echo "🔧 Building ${PROJ_NAME} from source: $SOURCE_PATH"
echo "📁 Pipeline root: ${PIPELINE_ROOT}"

###############################################################################
# Pre-cache OSS-Fuzz images on first run to improve performance
###############################################################################
if [[ -x "/cache-ossfuzz-images.sh" ]]; then
  /cache-ossfuzz-images.sh
fi

###############################################################################
# Delegate to pipeline Makefile with proper parameter passing
###############################################################################
cd "${PIPELINE_ROOT}"

# Set environment for make
export SOURCE_DIR="${PIPELINE_ROOT}/projects/${PROJ_NAME}/source"
export CVE_ID="$CVE_ID"
export SAN="${SANITIZERS:-address}"

# Delegate build to existing pipeline infrastructure
echo "🔧 Delegating to pipeline: make snapshot-${PROJ_NAME}"

# Capture both output and exit code properly, but avoid immediate exit that could destabilize container
BUILD_SUCCESS=true
if make "snapshot-${PROJ_NAME}" 2>&1 | tee build.log; then
  echo "✅ Build succeeded"
  echo "📋 Build completed. Recent output:"
  tail -n 20 build.log
else
  BUILD_EXIT_CODE=$?
  BUILD_SUCCESS=false
  echo "❌ Build failed with exit code: $BUILD_EXIT_CODE"
  echo "📋 Build error output (last 50 lines):"
  tail -n 50 build.log
  echo "📋 Full build log saved to: build.log"
  echo "TOOL_STATUS:FAILED:$BUILD_EXIT_CODE"
fi

###############################################################################
# Validate binary exists and report status
###############################################################################
if [[ "$BUILD_SUCCESS" == "true" ]] && [[ -e "$BINARY_PATH" ]]; then
  echo "✅ Binary ready at: $BINARY_PATH"
  echo "BUILD_RESULT:SUCCESS"
  exit 0
elif [[ "$BUILD_SUCCESS" == "false" ]]; then
  echo "❌ BUILD FAILED – make command returned error code"
  echo "Check build.log for details. Tool completed without container termination."
  echo "BUILD_RESULT:FAILED"
  exit 0  # Exit 0 to avoid container EOF, let agent handle via output parsing
else
  echo "❌ BINARY ERROR – build succeeded but binary not found at $BINARY_PATH"
  echo "Check build.log for details"
  echo "BUILD_RESULT:BINARY_MISSING"
  exit 0  # Exit 0 to avoid container EOF, let agent handle via output parsing
fi
